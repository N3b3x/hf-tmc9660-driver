# ESP-IDF specific
# sdkconfig and sdkconfig.defaults should be tracked (contain important ESP32 configuration)
# Only ignore backup files
**/sdkconfig.old

# Don't exclude .vscode folder
# .vscode/
# But exclude user-specific files
.vscode/settings.json.user
.vscode/*.backup

**/docs/doxygen/
docs/doxygen/
.DS_Store
