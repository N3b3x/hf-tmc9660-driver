  "ignoreWords": [
    "TODO",
    "FIXME",
    "HACK",
    "XXX",
    "TBD",
    "tmp",
    "temp"
  ],
  "ignorePaths": [
    "node_modules/**",
    "vendor/**",
    ".git/**",
    "build/**",
    "dist/**",
    "*.log",
    "*.tmp",
    "*.cache",
    "*.lock",
    "*.min.js",
    "*.min.css",
    "dependencies.lock",
    "package-lock.json",
    "Datasheet/**",
    "*.pdf",
    "*.bin",
    "*.hex",
    "*.elf",
    "*.map",
    "*.o",
    "*.a",
    "*.so",
    "*.dylib",
    "*.dll"
  ],
  "import": [
    "@cspell/dict-cpp/cspell-ext.json",
    "@cspell/dict-python/cspell-ext.json",
    "@cspell/dict-bash/cspell-ext.json",
    "@cspell/dict-yaml/cspell-ext.json",
    "@cspell/dict-json/cspell-ext.json",
    "@cspell/dict-markdown/cspell-ext.json"
  ],
  "dictionaries": [
    "cpp",
    "python",
    "bash",
    "yaml",
    "json",
    "markdown",
    "typescript",
    "javascript"
  ],
  "languageSettings": [
    {
      "languageId": "markdown",
      "dictionaries": ["markdown", "cpp"],
      "caseSensitive": false
    },
    {
      "languageId": "cpp",
      "dictionaries": ["cpp"],
      "caseSensitive": true
    },
    {
      "languageId": "python",
      "dictionaries": ["python"],
      "caseSensitive": true
    },
    {
      "languageId": "yaml",
      "dictionaries": ["yaml"],
      "caseSensitive": false
    },
    {
      "languageId": "json",
      "dictionaries": ["json"],
      "caseSensitive": false
    },
    {
      "languageId": "bash",
      "dictionaries": ["bash"],
      "caseSensitive": true
    }
  ],
  "overrides": [
    {
      "filename": "**/*.hpp",
      "languageId": "cpp",
      "dictionaries": ["cpp"],
      "caseSensitive": true
    },
    {
      "filename": "**/*.cpp",
      "languageId": "cpp", 
      "dictionaries": ["cpp"],
      "caseSensitive": true
    },
    {
      "filename": "**/*.md",
      "languageId": "markdown",
      "dictionaries": ["markdown", "cpp"],
      "caseSensitive": false
    },
    {
      "filename": "**/*.yml",
      "languageId": "yaml",
      "dictionaries": ["yaml"],
      "caseSensitive": false
    },
    {
      "filename": "**/*.yaml",
      "languageId": "yaml",
      "dictionaries": ["yaml"],
      "caseSensitive": false
    },
    {
      "filename": "**/*.json",
      "languageId": "json",
      "dictionaries": ["json"],
      "caseSensitive": false
    },
    {
      "filename": "**/*.py",
      "languageId": "python",
      "dictionaries": ["python"],
      "caseSensitive": true
    },
    {
      "filename": "**/*.sh",
      "languageId": "bash",
      "dictionaries": ["bash"],
      "caseSensitive": true
    }
  ],
  "useGitignore": true,
  "enableFiletypes": [
    "cpp",
    "hpp",
    "c",
    "h",
    "py",
    "sh",
    "yml",
    "yaml",
    "json",
    "md",
    "txt",
    "cmake",
    "toml"
  ]
}