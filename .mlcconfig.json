{
  "ignorePatterns": [
    {
      "pattern": ".*\\.html$",
      "replacement": ".md"
    }
  ],
  "httpStatusCodes": [
    {
      "codes": [400, 401, 403, 404, 429, 500, 502, 503, 504],
      "action": "warn"
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206]
}